# 复制为 .env 后填写；不要把真实值提交进仓库。
# 复制命令（PowerShell）： Copy-Item .env.example .env
# 复制命令（bash）：      cp .env.example .env

# ---- 预算（会被 lab.config.json 覆盖，二者取更小的那个）----
SEARCH_DAILY_BUDGET=200
GPU_BUDGET_HOURS=10

# ---- 可选：联网检索（白名单代理）----
ARXIV_API_BASE=https://export.arxiv.org/api/query
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
SEARCH_PROXY_TOKEN=

# ---- 可选：通知（留空则只打印到终端）----
NOTIFY_WEBHOOK=
NOTIFY_EMAIL=

# ---- 可选：模型服务（v0.1 不读这些变量）----
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
